@page
@model Razor.LyserødeSpejdere.Pages.MineAktiviteterModel
@inject global::LyserødeSpejdere.Data.IAktivitetTypeRepo typeRepo


<h1>Mine aktiviteter</h1>

<p>Her kan du se de aktiviteter, du har tilmeldt dig.</p>

<hr />

@if (Model.Aktiviteter.Count == 0)
{
    <p>Du er ikke tilmeldt nogen aktiviteter endnu.</p>
    <a href="/Aktivitet" class="btn btn-primary">
        Se aktiviteter
    </a>
}
else
{
    @foreach (var aktivitet in Model.Aktiviteter)
    {

        var type = typeRepo.GetById(aktivitet.AktivitetTypeId);

        <div class="card p-3 mb-3">
            <h4>@type?.Navn</h4>

            <p>
                Sted: @aktivitet.Sted <br />
                Start: @aktivitet.StartTid.ToString("dd-MM-yyyy HH:mm") <br/>
                Slut: @aktivitet.SlutTid.ToString("dd-MM-yyyy HH:mm")

            </p>
            <form method="Post">
                <input type="hidden"
                       name="aktivitetId"
                       value="@aktivitet.AktivitetId"/>
                
                <button asp-page-handler="Frameld"
                        typeof="submit"
                        class="btn btn-danger">
                      Frameld
                </button>
            </form>


       </div>
    }
}

