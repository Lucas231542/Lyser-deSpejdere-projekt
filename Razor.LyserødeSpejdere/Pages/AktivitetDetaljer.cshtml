@page "{id:int}"
@model Razor.LyserødeSpejdere.Pages.AktivitetDetaljerModel
@* ----- Lavet af Sofyane Amrhar: Viser detaljer om en aktivitet ------ *@

<h1>@Model.Type.Navn</h1>
<p>@Model.Type.Beskrivelse</p>

<hr />

<dl class="row">
<dt class="col-sm-3">Dato</dt>
<dd class="col-sm-9">@Model.Aktivitet.StartTid.ToString("dd/MM/yyyy")</dd>
<DT class="col-sm-3">Sted</dt>
<dd class="col-sm-9">@Model.Aktivitet.Sted</dd>

<dt class="col-sm-3">Tid</dt>
<dd class="col-sm-9">@Model.Aktivitet.StartTid.ToString("HH:mm") - @Model.Aktivitet.SlutTid.ToString("HH:mm")</dd>
<dt class="col-sm-3">Minimumsalder</dt>
<dd class="col-sm-9">
    @(Model.Type.MinAlder == 0 ? "Ingen aldersgrænse" : Model.Type.MinAlder + " år")
</dd>

<dt class="col-sm-3">Max deltagere</dt>
<dd class="col-sm-9">
    @(Model.Type.MaxDeltagere == 0 ? "Ingen grænse" : Model.Type.MaxDeltagere.ToString())
</dd>
<dt class="col-sm-3">Tilmeldte</dt>
<dd class="col-sm-9">
    @Model.AntalTilmeldte
    @if (Model.Type.MaxDeltagere > 0)
    {
        <span>af @Model.Type.MaxDeltagere</span>
    }
</dd>

<dt class="col-sm-3">Krævede tegn </dt>
<dd class="col-sm-9">
@if (Model.Krav.Count == 0)
{
    <span>Ingen</span>
    
}
else
{
    @foreach (var tegn in Model.Krav)
    {
        <span class="badge bg-info">@tegn.Navn</span>
    }
}
</dd>


@* Tilføjet af Sofyane Amrhar: lederen kan se, hvem der deltager (casen) *@

@if (Model.ErLoggetInd)
{
    <h3>Deltagere</h3>
    @if (Model.Deltagere.Count == 0)
    {
        <p>Ingen er tilmeldt endnu.</p>
    }
    else
    {
        <ul>
            @foreach (var d in Model.Deltagere)
            {
                <li>@d.Navn</li>
            }
        </ul>
    }
}


<a asp-page="/Aktivitet" class="btn btn-secondary">Tilbage til aktiviteter</a>
</dl>
