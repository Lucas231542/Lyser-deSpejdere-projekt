@page
@model Razor.LyserødeSpejdere.Pages.AdminsterAktivitetModel
@inject global::LyserødeSpejdere.Data.IAktivitetTypeRepo typeRepo
<h1>Hello world</h1>

<p class="Jumbotron">Velkommen til administreringen af aktiviteter</p>
<p></p>
<div class="row">
    <div class="col-md-6">
        <h2>Opret ny aktivitet</h2>
        <form method="post">
            <div class="form-group">
                <label asp-for="AktivitetTypeId"></label>
                <select asp-for="AktivitetTypeId" class="form-control">
                    <option value="">Vælg aktivitetstype</option>

                    @foreach (var type in Model.AktivitetTyper)
                    {
                        <option value="@type.AktivitetTypeId">@type.Navn</option>
                    }
                </select>
                <span asp-validation-for="AktivitetTypeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StartTid"></label>
                <input asp-for="StartTid" class="form-control" />
                <span asp-validation-for="StartTid" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SlutTid"></label>
                <input asp-for="SlutTid" class="form-control" />
                <span asp-validation-for="SlutTid" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Sted"></label>
                <input asp-for="Sted" class="form-control" />
                <span asp-validation-for="Sted" class="text-danger"></span>
            </div>
            <button asp-page-handler="Opret"
                    type="submit"
                    class="btn btn-primary">
                Opret aktivitet

            </button>


			
        </form>
    </div>


@foreach (var aktivitet in Model.Aktiviteter)
{

    var type = typeRepo.GetById(aktivitet.AktivitetTypeId);

    <div class="card p-3 mb-3">
        <h4>@type?.Navn</h4>

        <p>
            Sted: @aktivitet.Sted <br />
            Start: @aktivitet.StartTid.ToString("dd-MM-yyyy HH:mm") <br />
            Slut: @aktivitet.SlutTid.ToString("dd-MM-yyyy HH:mm")

        </p>
        <form method="Post">
            <input type="hidden"
                   name="aktivitetId"
                   value="@aktivitet.AktivitetId" />

            <button asp-page-handler="Slet"
                    type="submit"
                    class="btn btn-danger">
                Slet
            </button>

            <button asp-page-handler="Rediger"
                    type="submit"
                    class="btn btn-warning">
                Rediger
            </button>
        </form>


    </div>
}



