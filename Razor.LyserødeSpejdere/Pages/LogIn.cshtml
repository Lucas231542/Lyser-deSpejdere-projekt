@page
@model Razor.LyserødeSpejdere.Pages.LogInModel


<div class="container mt-5" style="max-width: 450px;">
    <h1 class="text-center">Log ind</h1>

    <form method="post">
        <div class="mb-3">
            <label asp-for="Brugernavn" class="form-label">
                Brugernavn
            </label>
            <input asp-for="Brugernavn" class="form-control"
                   placeholder="Skriv brugernavn" />
        </div>

        <div class="mb-3">
            <label asp-for="Adgangskode" class="form-label">
                Adgangskode
            </label>
            <input asp-for="Adgangskode" type="password"
                   class="form-control"
                   placeholder="Skriv adgangskode" />
        </div>

        <div class="mb-3">
            <input asp-for="HuskMig" class="form-check-input"/>
            <label asp-for="HuskMig" class="form-check-label">
                HuskMig
            </label>            
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">
            Log ind
        </button>

        <p class="text-danger mt-3">@Model.Fejl</p>
    </form>
</div>
