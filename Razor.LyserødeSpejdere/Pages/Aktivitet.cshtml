@page
@model Razor.LyserødeSpejdere.Pages.AktivitetModel
@* Tilføjet af Sofyane Amrhar: henter aktivitetstypens navn (kap - 10, @inject)*@
@inject global::LyserødeSpejdere.Data.IAktivitetTypeRepo typeRepo



<h1>De Lyserøde Spejdere</h1>
<h2>Spejderlejr i Hedeland</h2>

<p class="intro">
    Her kan du se alle aktiviteter på lejren og tilmelde dig dine favoritter.
</p>

<hr />

<h2>Vores aktiviteter</h2>
@*---- Tilføjet af Sofyane Amrhar: aktiviteter fra databasen (kap - 6) ----*@
@if (TempData["Fejl"] != null)
{
    <div class="alert alert-danger">
        @TempData["Fejl"]
    </div>
}


<table class="table table-striped">

    <thead>
    <tr>
        <th>Aktivitet</th>
        <th>Dato</th>
        <th>Tid</th>
        <th>Sted</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Aktiviteter)
    {
        var type = typeRepo.GetById(item.AktivitetTypeId);
        <tr>
            <td>@type?.Navn</td>
            <td>@item.StartTid.ToString("dd-MM-yyyy")</td>
            <td>@item.StartTid.ToString("HH:mm") - @item.SlutTid.ToString("HH:mm")</td>
            <td>@item.Sted</td>
            <td><img src="@type?.ImagePath" width="150" class="img-fluid" /> </td>

            <td>
                <form method="post" asp-page-handler="Tilfoej">
                      <input type="hidden"
                             name="aktivitetId"
                             value="@item.AktivitetId"/>
                      
                      <button type="submit"
                              class="btn btn-success">
                          Tilmeld
                      </button>

                </form>
            </td>
        </tr>
    }

    </tbody>
</table>
