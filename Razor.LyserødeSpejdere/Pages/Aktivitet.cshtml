@page
@model Razor.LyserødeSpejdere.Pages.AktivitetModel



<h1>De Lyserøde Spejdere</h1>
<h2>Spejderlejr i Hedeland</h2>

<p class="intro">
    Her kan du se alle aktiviteter på lejren og tilmelde dig dine favoritter.
</p>

<hr />

<h2>Vores aktiviteter</h2>

<div class="aktiviteter">

    <section class="aktivitet">
        <div class="aktivitet-tekst">
            <h3>Ridning</h3>
            <p>Besøg en gård og prøv at ride på heste.</p>
            <p><strong>Dato:</strong> 30. oktober 2026</p>
            <p><strong>Tid:</strong> 10:00 - 12:00</p>
            <p><strong>Sted:</strong> Gården</p>
            <p><strong>Krav:</strong> Mindst 10 år og ridemærke</p>

            <form method="post" asp-page-handler="Tilfoej">
                <input type="hidden" name="aktivitetNavn" value="Ridning" />
                <button type="submit">Tilmeld mig</button>
            </form>
        </div>
        <img src="/images/hest.webp" alt="Ridning på heste" />
    </section>

    <hr />

    <section class="aktivitet">
        <div class="aktivitet-tekst">
            <h3>Mad over bål</h3>
            <p>Vi laver lækker mad over bål sammen.</p>
            <p><strong>Dato:</strong> 6. november 2026</p>
            <p><strong>Tid:</strong> 18:00 - 20:00</p>
            <p><strong>Sted:</strong> Lejrpladsen</p>
            <p><strong>Krav:</strong> Ingen særlige krav</p>

            <form method="post" asp-page-handler="Tilfoej">
                <input type="hidden" name="aktivitetNavn" value="Mad over bål" />
                <button type="submit">Tilmeld mig</button>
            </form>
        </div>
        <img src="/images/bål.jpg" alt="Madlavning over bål" />
    </section>

    <hr />

    <section class="aktivitet">
        <div class="aktivitet-tekst">
            <h3>Fang dyr ved vandhullet</h3>
            <p>Vi undersøger smådyr i vandet med net.</p>
            <p><strong>Dato:</strong> 7. december 2026</p>
            <p><strong>Tid:</strong> 10:00 - 12:00</p>
            <p><strong>Sted:</strong> Vandhullet</p>
            <p><strong>Krav:</strong> Mindst 8 år</p>

            <form method="post" asp-page-handler="Tilfoej">
                <input type="hidden" name="aktivitetNavn" value="Fang dyr ved vandhullet" />
                <button type="submit">Tilmeld mig</button>
            </form>
        </div>
        <img src="/images/fish.jpg" alt="Smådyr ved vandhullet" />
    </section>

</div>
